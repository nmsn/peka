{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun", "node"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "typeRoots": ["./src/types", "./node_modules/@types"],
    "paths": {
      "electrobun/bun": ["src/types/electrobun-bun-shim.d.ts"],
      "electrobun/view": ["src/types/electrobun-view-shim.d.ts"]
    }
  },
  "include": ["electrobun.config.ts", "src/**/*.ts", "src/**/*.tsx"]
}
