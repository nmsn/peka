{
  "name": "peka-electrobun",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Peka - A color picker for macOS, built with Electrobun",
  "type": "module",
  "scripts": {
    "dev": "electrobun dev --watch",
    "dev:auto-pick": "PEKA_AUTO_PICK=foreground electrobun dev --watch",
    "build": "electrobun build",
    "run": "electrobun run",
    "test:color-pick": "bun run src/bun/test-color-picker.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "electrobun": "^1.15.1",
    "color-name-list": "^14.32.0",
    "colord": "^2.9.3",
    "zustand": "^4.4.0",
    "i18next": "^25.8.13",
    "lucide-react": "^0.575.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-i18next": "^16.5.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  }
}
